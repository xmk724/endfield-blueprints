et/gh/xmk724/endfield-blueprints@main/images/xirang-lowpower-1.jpg"]},{"id":"xirang-aux","name":"息壤低电满速（配套）","map":"武陵","products":["息壤"],"code":"EF018OI493OU3120UI73","desc":"息壤低电满速的配套蓝图，与上一条轴对称摆。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/xirang-aux-1.jpg"]},{"id":"hub-a","name":"枢纽区 A 线（高容电池超级线）","map":"四号谷地","products":["电池","高容电池"],"code":"EF015i2163628u92eIoe","desc":"总线拐角开始放 A+B+C 三线。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub-a-1.jpg"]},{"id":"hub-b","name":"枢纽区 B 线","map":"四号谷地","products":["电池","高容电池"],"code":"EF018OIei6iI91AiUI73","desc":"高容电池超级线的 B 线。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub-b-1.jpg"]},{"id":"hub-c","name":"枢纽区 C 线","map":"四号谷地","products":["电池","高容电池"],"code":"EF01081O5A51Ui29E179","desc":"高容电池超级线的 C 线。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub-c-1.jpg"]},{"id":"hub-capsule","name":"总线精选胶囊","map":"四号谷地","products":["胶囊","精选胶囊"],"code":"EF015i2163628uaUeIoe","desc":"1 个总线精选胶囊。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub-capsule-1.jpg"]},{"id":"subbase-capsule","name":"副基地精选胶囊","map":"四号谷地","products":["胶囊","精选胶囊"],"code":"EF01o5uiA9Au063iIieO","desc":"随意一个副基地，全满级，可造可不造。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/subbase-capsule-1.jpg"]},{"id":"subbase-plugin","name":"副基地胶囊插件","map":"四号谷地","products":["胶囊","插件"],"code":"EF013Eo7e1eo6auA0579","desc":"副基地胶囊插件。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/subbase-plugin-1.jpg"]},{"id":"wuling-left","name":"武陵一键毕业 左线","map":"武陵","products":["电池","胶囊","装备原件"],"code":"EF01Oe4a1u143Io29Ee4","desc":"武陵毕业左线，先建左线再放右线。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/wuling-left-1.jpg"]},{"id":"wuling-right","name":"武陵一键毕业 右线","map":"武陵","products":["电池","胶囊","装备原件"],"code":"EF013Eo7e1eo6aU30579","desc":"武陵毕业右线，无法紧贴，需要左线全部建好后再放。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/wuling-right-1.jpg"]},{"id":"capsule-can","name":"胶囊和罐头二合一","map":"四号谷地","products":["胶囊","罐头"],"code":"EF01i1UI03UIe2a72U4","desc":"胶囊和罐头二合一产线，需要稳定流输入，不然瓶子生产速度跟不上会卡住制造槽位。","source":"360游戏","images":[]},{"id":"purple-med","name":"紧凑满速紫药产线","map":"四号谷地","products":["紫药","胶囊","荞花"],"code":"EF015i2O4OI78u63eIoe","desc":"输入 240u/m 蓝铁，输出 6u/m 紫药（全速），建议选荞花。可在主基地贴边贴角放三个；主基地核心移到角落，每个蓝图中心两个采种机放 20 荞花/20 柑实，外侧两个放 20 砂叶。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/purple-med-1.jpg","https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/purple-med-2.jpg"]},{"id":"highbat-economy","name":"紧凑高容满速线（经济/发电两用）","map":"四号谷地","products":["电池","高容电池","发电"],"code":"EF011I9a6aA8eUa134O7","desc":"输入源矿 180u/m、蓝铁 120u/m，输出全速 6u/m 高容电池，可调发电/卖钱比例。每个分基地可放一个。两个采种机放至少 10 个砂叶。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/highbat-economy-1.jpg","https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/highbat-economy-2.jpg"]},{"id":"wuling-upper","name":"武陵自循环毕业 右侧上半","map":"武陵","products":["息壤","电池","装备原件"],"code":"EF018OIe8oa3012aUi73","desc":"武陵自循环毕业的右侧上半部分。需跨地区拉满蓝铁；初期电不够可从四号谷地搬电池过渡。右侧需两台水泵，各自连左右两个端口。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/wuling-upper-1.jpg"]},{"id":"wuling-lower","name":"武陵自循环毕业 右侧下半","map":"武陵","products":["息壤","电池","装备原件"],"code":"EF014AE642u5I371Ea1A","desc":"右侧下半部分，按右侧上下、左侧顺序摆放。三联版采种机放足量砂叶，二联版放武陵可复制植物。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/wuling-lower-1.jpg"]},{"id":"wuling-left2","name":"武陵自循环毕业 左侧","map":"武陵","products":["装备原件","药剂"],"code":"EF01o5uioI18a63OI2eO","desc":"左侧负责装备原件与药剂。药剂需要什么就在左侧采种机放足量对应植物，装备原件会自己启动。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/wuling-left2-1.jpg"]},{"id":"wuling-furnace","name":"单台满速洪炉","map":"武陵","products":["息壤"],"code":"EF01I43AIu6o19735E08","desc":"单台满速洪炉，自循环可直接放置。武陵自循环毕业包里单台洪炉不用摆。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/wuling-furnace-1.jpg"]},{"id":"plant-selfloop","name":"植物自循环","map":"四号谷地","products":["植物","植物粉末","碳块"],"code":"EF01U9eaEi7uIOE87Oa8","desc":"最重要、用得最多的蓝图。接粉碎机出植物粉末，接精炼炉得碳块，什么都不接就是种植园。记得铺两个种荞花和砂叶，后面手动往采种机填。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/plant-selfloop-1.jpg"]},{"id":"steel-highcrystal","name":"钢制零件 / 高晶零件 基础产线","map":"四号谷地","products":["零件","钢制零件","高晶零件"],"code":"EF01ao6ui91OEA90oe5e","desc":"以这条为基础还能出其他材料：把输入的蓝铁矿换成紫晶矿就是高晶零件。高晶装备原件也可以用它改。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/steel-highcrystal-1.jpg"]},{"id":"highcrystal-equip","name":"高晶装备原件","map":"四号谷地","products":["装备原件","高晶装备"],"code":"EF01Oe4Ao2509I8094e4","desc":"紫色 lv50 装备材料，效率只有一半，需求不大够用。后面进武陵能直接打金装。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/highcrystal-equip-1.jpg"]},{"id":"yuan-park","name":"源石研究园（基站前站）整合蓝图","map":"四号谷地","products":["电池","高容电池","钢制零件","砂叶粉末"],"code":"EF016u08Ua9457UuO83e","desc":"仓库存取线在上面。协议核心位置：下空 10 格、右空 16 格。包含高容谷地电池发电、钢制零件、砂叶粉末各一条。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/yuan-park-1.jpg"]},{"id":"power-upland","name":"供能高地（建设规划区）整合蓝图","map":"四号谷地","products":["电池","高容电池","中容电池","砂叶粉末"],"code":"EF01081Ie6aE2i21E179","desc":"仓库存取线在上面。协议核心：下空 9 格、右空 6 格。两条电池线 + 两条砂叶粉末线。断电就摆一排发电机手动喂电池。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/power-upland-1.jpg"]},{"id":"valley-pass","name":"谷地通道（临时避难所）整合蓝图","map":"四号谷地","products":["钢制瓶","砂叶粉末"],"code":"EF011I93A065OUoo34O7","desc":"仓库存取线在上面。协议核心：左空 9 格、下空 12 格。两条钢制瓶 + 三条砂叶粉末。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/valley-pass-1.jpg"]},{"id":"hub1-x","name":"枢纽区 1（左上角）","map":"四号谷地","products":["综合","调度券"],"code":"EF015i2UIE4a0u91eIoe","desc":"枢纽区五张拆开蓝图的第一张，放左上角。仓库存取线在上和右，俯瞰模式可能要旋转。协议核心先放下空 5 右空 20，再对准传送带挪。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub1-x-1.jpg","https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub1-x-2.jpg"]},{"id":"hub2-x","name":"枢纽区 2（左下角）","map":"四号谷地","products":["综合","调度券"],"code":"EF01ao6ui91OEA4eoe5e","desc":"放枢纽区 1 下面，对准图中圈起来的位置。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub2-x-1.jpg","https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub2-x-2.jpg"]},{"id":"hub3-x","name":"枢纽区 3（右上角）","map":"四号谷地","products":["综合","调度券"],"code":"EF0193ao71024e6i5uI2","desc":"放枢纽区 1 右边，右上角。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub3-x-1.jpg","https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub3-x-2.jpg"]},{"id":"hub4-x","name":"枢纽区 4（右边）","map":"四号谷地","products":["综合","调度券"],"code":"EF01i1U947Ao82o272U4","desc":"放枢纽区 3 下边，对准圈起来的位置。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub4-x-1.jpg","https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub4-x-2.jpg"]},{"id":"hub5-x","name":"枢纽区 5（右下角）","map":"四号谷地","products":["综合","调度券"],"code":"EF01I43E68uie9a45o08","desc":"放枢纽区 4 下边，右下角。这套铺完日均约 270 万调度券。","source":"17173","images":["https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub5-x-1.jpg","https://cdn.jsdelivr.net/gh/xmk724/endfield-blueprints@main/images/hub5-x-2.jpg"]},{"id":"g1-purple-factory","name":"全功率紫药厂","map":"四号谷地","products":["紫药","药品"],"code":"EF01o5u27iAO463EIieO","desc":"四号谷地药品毕